# Sao chép thành .env rồi chỉnh nếu cần: cp .env.example .env
# Docker Compose đọc file này khi nội suy ${...}.
# dotnet run nạp file này trước appsettings.json. Biến đã có trong môi trường không bị ghi đè.

MSSQL_SA_PASSWORD=Warehouse@Dev123
MSSQL_PORT=1433
API_HTTP_PORT=5161
MSSQL_DATABASE=WarehouseDb

# Chuỗi kết nối khi API chạy trên máy và SQL Server nằm trong Docker.
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=WarehouseDb;User Id=sa;Password=Warehouse@Dev123;TrustServerCertificate=True

# true thì API tự áp migration lúc khởi động. Compose của service api luôn bật true.
Database__ApplyMigrations=false

# Nhiều origin thì cách nhau bằng dấu phẩy.
Cors__Origins=http://localhost:3000

# JWT. SigningKey dài ít nhất 32 ký tự. Đổi trước khi deploy.
Jwt__Issuer=warehouse
Jwt__Audience=warehouse-admin
Jwt__SigningKey=warehouse-dev-signing-key-change-me-32b
Jwt__ExpiresMinutes=480

# Tạo tài khoản này lúc API khởi động nếu email chưa có. Không ghi đè mật khẩu đã đặt.
Auth__SeedEmail=admin@kho.local
Auth__SeedPassword=Admin@123
Auth__SeedName=Quản trị
