# Sao chép thành .env: cp .env.example .env
# Next.js đọc file này khi npm run dev và npm run build.

# API mà trình duyệt gọi qua proxy /api của Next.js.
API_URL=http://localhost:5161

# API mà container frontend gọi. localhost trong container không phải máy host.
API_URL_DOCKER=http://host.docker.internal:5161

WEB_PORT=3000
